{
  "name": "pokerswipe-polyana-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node tests/polyana_map.js",
    "test:polyana": "node tests/polyana_regression.js",
    "test:training": "node --test solver/tests/sessionReview.test.js solver/tests/sessionResume.test.js solver/tests/trainingUiRenderer.test.js solver/tests/swipeGesture.test.js solver/tests/playerProfileUi.test.js solver/tests/personalizationP0Selector.test.js solver/tests/positionAwarenessStrictBand.test.js solver/tests/gradingPathConsistency.test.js solver/tests/gradingConsistency.test.js",
    "test:training-audit": "node --test solver/tests/trainingQualityAudit.test.js",
    "pretest:e2e:daily": "playwright install chromium",
    "test:e2e:daily": "node tests/daily_e2e_verify.mjs",
    "test:e2e:navigation": "node tests/navigation_daily_production.e2e.mjs",
    "test:e2e:polyana": "node tests/polyana_navigation.e2e.mjs",
    "test:e2e:ui-smoke": "node tests/ui-smoke.e2e.mjs",
    "test:e2e:ui-geometry": "node tests/ui-geometry.e2e.mjs",
    "test:e2e:ui-visual": "node tests/ui-visual-baseline.mjs",
    "test:e2e:ui-stress": "node tests/ui-navigation-stress.e2e.mjs",
    "test:ui-audit": "node tests/ui-system-audit.mjs",
    "test:css-collision": "node tests/css-collision-report.mjs",
    "test:poker-correctness": "node --test solver/tests/handEvaluator.test.js solver/tests/handEvaluator.exhaustive.test.js solver/tests/handBucket.test.js solver/tests/libraryEvProvenance.test.js",
    "test:poker-library": "node --test solver/tests/pokerLibraryValidation.test.js && node solver/scripts/taskContextIntegrityAudit.mjs",
    "test:poker-context": "node --test solver/tests/pokerValidationGates.test.js",
    "test:poker-provenance": "node solver/scripts/pokerProvenanceAudit.mjs",
    "test:preflop-sensitivity": "node solver/scripts/preflopStackSensitivity.mjs",
    "test:poker-validation": "npm run test:poker-library && npm run test:poker-context && npm run test:poker-provenance && npm run test:preflop-sensitivity && node solver/scripts/postflopContextSensitivity.mjs && node solver/scripts/pokerPolicyBlockerClassification.mjs",
    "test:grading-consistency": "node --test solver/tests/gradingConsistency.test.js solver/tests/gradingPathConsistency.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^26.1.0",
    "wrangler": "^4.31.0"
  }
}
