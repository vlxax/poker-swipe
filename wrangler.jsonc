
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poker-swipe",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "POLYANA_KV",
      "id": "74091d04ed984e31a25f0bbafee6d51a"
    }
  ],
  "vars": {
    "SYNC_CONCURRENCY": "4"
  }
}
