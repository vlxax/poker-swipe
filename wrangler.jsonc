
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokerswipe-polyana-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "POLYANA_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "SYNC_CONCURRENCY": "4"
  }
}
