    * Close transient UI before switching routes. No cross-screen DOM scrub.
    */
   function teardownTransientUI() {
+    // Route changes must never leave a fullscreen Daily/legacy overlay above the next screen.
+    // Prefer the owning bridge cleanup when present, but also clean stale DOM left by older builds.
     if (window.PsHandDayBridge?.dismissOverlay) {
       window.PsHandDayBridge.dismissOverlay();
     }
+    const staleHandDay = document.getElementById('psHandDayOverlay');
+    if (staleHandDay) {
+      staleHandDay.style.display = 'none';
+      staleHandDay.style.pointerEvents = 'none';
+      staleHandDay.setAttribute('aria-hidden', 'true');
+      const staleFrame = staleHandDay.querySelector('iframe');
+      if (staleFrame) {
+        try { staleFrame.src = 'about:blank'; } catch (_) { /* ignore */ }
+      }
+    }
     if (typeof window.closeModal === 'function') {
       try { window.closeModal(); } catch (_) { /* ignore */ }
     }
